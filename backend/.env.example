# =============================================================================
# Environment Configuration Template — Sahāyu Backend
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file — only this template.
# =============================================================================

# ── PostgreSQL Database URL ─────────────────────────────────────────────────
# Local development:
#   DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/gig_services
# Render PostgreSQL (Internal URL — paste from Render dashboard):
#   DATABASE_URL=postgresql+psycopg://user:password@host/dbname
# Supabase (Session Pooler URL — use port 5432):
#   DATABASE_URL=postgresql+psycopg://postgres.xxxx:<password>@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/gig_services

# ── JWT Secret Key ──────────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(48))"
# On Render, use generateValue: true — this is auto-generated for you.
SECRET_KEY=replace_with_a_strong_random_secret_key_min_32_chars

# ── JWT Settings ────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Application Metadata ────────────────────────────────────────────────────
APP_TITLE=Cooperative Gig Services API
APP_VERSION=1.0.0

# ── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── CORS Allowed Origins ─────────────────────────────────────────────────────
# Comma-separated list. Set to your actual frontend URL(s) in production.
# Example: ALLOWED_ORIGINS=https://sahayu.vercel.app,https://www.sahayu.in
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
